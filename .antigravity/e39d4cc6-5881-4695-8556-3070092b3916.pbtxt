      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"package com.example.ui.theme\\n\\nimport android.app.Activity\\nimport androidx.compose.material3.MaterialTheme\\nimport androidx.compose.material3.lightColorScheme\\nimport androidx.compose.runtime.Composable\\nimport androidx.compose.runtime.SideEffect\\nimport androidx.compose.ui.graphics.toArgb\\nimport androidx.compose.ui.platform.AndroidViewConfiguration\\nimport androidx.compose.ui.platform.LocalView\\nimport androidx.core.view.WindowCompat\\n\\nprivate val LightColorScheme = lightColorScheme(\\n    primary = BlueColor,\\n    onPrimary = WhiteColor,\\n    secondary = AccentOrange,\\n    onSecondary = WhiteColor,\\n    tertiary = AccentPurple,\\n    background = BackgroundCream,\\n    onBackground = MainText,\\n    surface = CardBackground,\\n    onSurface = MainText,\\n    surfaceVariant = SurfaceVariantColor\\n)\\n\\n@Composable\\nfun ColorsOfFaithTheme(\\n    content: @Composable () -> Unit\\n) {\\n    val colorScheme = LightColorScheme\\n    val view = LocalView.current\\n    if (!view.isInEditMode) {\\n        SideEffect {\\n            val window = (view.context as Activity).window\\n            window.statusBarColor = colorScheme.primary.toArgb()\\n            WindowCompat.getInsetsController(window, view).isAppearanceLightStatusBars = false\\n        }\\n    }\\n\\n    MaterialTheme(\\n        colorScheme = colorScheme,\\n        typography = Typography,\\n        content = content\\n    )\\n}\\n\",\"Description\":\"Create Material3 theme for Colors of Faith\",\"DescriptionOverride\":false,\"Overwrite\":true,\"TargetFile\":\"/app/src/main/java/com/example/ui/theme/Theme.kt\",\"toolAction\":\"Creating Theme.kt\",\"toolSummary\":\"Write Theme.kt\"}"
