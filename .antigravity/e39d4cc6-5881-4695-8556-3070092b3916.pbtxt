      arguments_json: "{\"CodeContent\":\"package com.example.ui.screens\\n\\nimport androidx.compose.foundation.layout.*\\nimport androidx.compose.foundation.shape.RoundedCornerShape\\nimport androidx.compose.material3.*\\nimport androidx.compose.runtime.Composable\\nimport androidx.compose.ui.Modifier\\nimport androidx.compose.ui.graphics.Color\\nimport androidx.compose.ui.text.font.FontWeight\\nimport androidx.compose.ui.unit.dp\\nimport androidx.compose.ui.unit.sp\\nimport com.example.ui.components.AppTopBar\\nimport com.example.ui.theme.*\\n\\n@Composable\\nfun AboutPrivacyScreen(\\n    onNavigateBack: () -> Unit\\n) {\\n    Scaffold(\\n        topBar = {\\n            AppTopBar(\\n                title = \\\"About & Privacy\\\",\\n                onBackClick = onNavigateBack\\n            )\\n        },\\n        containerColor = BackgroundCream\\n    ) { padding ->\\n        Column(\\n            modifier = Modifier\\n                .fillMaxSize()\\n                .padding(padding)\\n                .padding(16.dp),\\n            verticalArrangement = Arrangement.spacedBy(16.dp)\\n        ) {\\n            Card(\\n                shape = RoundedCornerShape(20.dp),\\n                colors = CardDefaults.cardColors(containerColor = Color.White),\\n                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)\\n            ) {\\n                Column(modifier = Modifier.padding(20.dp)) {\\n                    Text(\\n                        text = \\\"Colors of Faith \342\200\224 Bible for Kids\\\",\\n                        style = MaterialTheme.typography.titleLarge,\\n                        fontWeight = FontWeight.Bold,\\n                        color = MainText\\n                    )\\n                    Spacer(modifier = Modifier.height(8.dp))\\n                    Text(\\n                        text = \\\"Version 1.0\\\",\\n                        style = MaterialTheme.typography.bodyMedium,\\n                        color = Color.Gray\\n                    )\\n                    Spacer(modifier = Modifier.height(12.dp))\\n                    Text(\\n                        text = \\\"Designed to teach children the Christian message of salvation through the traditional Colors of Salvation / Wordless Book concept. Children can explore interactive color lessons, read accurate KJV Bible verses, take quizzes, track their learning journey, and pray.\\\",\\n                        style = MaterialTheme.typography.bodyLarge,\\n                        color = MainText\\n                    )\\n                }\\n            }\\n\\n            Card(\\n                shape = RoundedCornerShape(20.dp),\\n                colors = CardDefaults.cardColors(containerColor = Color.White),\\n                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)\\n            ) {\\n                Column(modifier = Modifier.padding(20.dp)) {\\n                    Text(\\n                        text = \\\"Privacy & Offline Guarantee\\\",\\n                        style = MaterialTheme.typography.titleLarge,\\n                        fontWeight = FontWeight.Bold,\\n                        color = BlueColor\\n                    )\\n                    Spacer(modifier = Modifier.height(8.dp))\\n                    Text(\\n                        text = \\\"\342\200\242 100% Offline: No internet connection is required.\\\\n\342\200\242 No Ads or Tracking: No third-party analytics, tracking, or ads.\\\\n\342\200\242 No Accounts: No registration or personal data collection.\\\\n\342\200\242 Local Storage Only: Learning progress, bookmarks, and quiz scores are stored securely and privately on your device.\\\",\\n                        style = MaterialTheme.typography.bodyLarge,\\n                        color = MainText\\n                    )\\n                }\\n            }\\n        }\\n    }\\n}\\n\",\"Description\":\"Create AboutPrivacyScreen composable with offline privacy guarantees\",\"Descri